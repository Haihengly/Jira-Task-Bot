# Jira Configuration
JIRA_EMAIL=your_jira_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian OAuth 2.0 (3LO) App
ATLASSIAN_CLIENT_ID=your_atlassian_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# SQLite Database
# When running in Docker, the volume is mounted at /app/data
DB_PATH=/app/data/mapping.db

# Internal Inter-Service API Key and URLs
INTERNAL_API_KEY=your_secure_internal_api_key_here
BOT_INTERNAL_URL=http://bot:3030/internal/generate-report

# Cron Job Configuration
MORNING_CRON_SCHEDULE=0 8 * * 1-5
EVENING_CRON_SCHEDULE=0 17 * * 1-5
CRON_TIMEZONE=Asia/Phnom_Penh

# Admin Alert Configuration (Optional)
ADMIN_CHAT_ID=your_admin_telegram_chat_id
